---
import PageShell from '../components/PageShell.astro';
import SeoHead from '../components/SeoHead.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  heroImageSrc?: string;
  heroImageAlt?: string;
  heroImageMode?: 'cropped' | 'natural';
  pageKind?: 'default' | 'home';
  includeFlockingScript?: boolean;
}

const {
  title = 'MylesBorins.com',
  description = 'portfolio and blog of myles borins',
  canonicalUrl,
  noindex = false,
  heroImageSrc,
  heroImageAlt = '',
  heroImageMode = 'cropped',
  pageKind = 'default',
  includeFlockingScript = false
} = Astro.props;
---

<PageShell
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  noindex={noindex}
  heroImageSrc={heroImageSrc}
  heroImageAlt={heroImageAlt}
  heroImageMode={heroImageMode}
  pageKind={pageKind}
  includeFlockingScript={includeFlockingScript}
>
  <Fragment slot="head">
    <SeoHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      noindex={noindex}
      heroImageSrc={heroImageSrc}
      heroImageAlt={heroImageAlt}
    />
  </Fragment>
  <Fragment slot="hero">
    <slot name="hero" />
  </Fragment>
  <slot />
</PageShell>